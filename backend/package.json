{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "NODE_ENV=test tsx --test tests/**/*.test.ts",
    "test:identity:db": "NODE_ENV=test tsx --test tests/identityRbac.db.test.ts",
    "test:stock-functional:db": "NODE_ENV=test tsx --test tests/stockFunctional.db.test.ts",
    "seed:sest:functional": "node --max-old-space-size=192 scripts/seed-sest-functional.cjs",
    "stock:units:audit": "node scripts/unit-catalog-audit.cjs",
    "stock:integrity": "node scripts/database-audit.cjs integrity",
    "sector:retirement:audit": "node scripts/sector-retirement-audit.cjs",
    "identity:audit": "node scripts/database-audit.cjs identity",
    "test:tenant:db": "NODE_ENV=test tsx --test tests/multiTenantIsolation.db.test.ts",
    "build": "prisma generate && tsc && cp -r src/generated dist/src/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/multer": "^2.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.6.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
