PORT=3333
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=sobra_corte"
PRIVATE_KEY="use-the-same-test-key-as-dass-auth-service"
CORS_ORIGINS="http://localhost:3000"
GLOBAL_ADMIN_IDENTITIES=""

# Ajustes opcionais do pool; os valores abaixo são os padrões da aplicação.
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000
