generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
  schemas  = ["sobra_corte", "autenticacao"]
}

model FactoryUnit {
  id     Int     @id @default(autoincrement())
  code   String  @unique
  name   String
  active Boolean @default(true)

  materials         Material[]
  locations         Location[]
  materialLocations MaterialLocation[]
  movements         Movement[]
  users             User[]
  units             UnitConfig[]
  categories        CategoryConfig[]
  origins           OriginConfig[]

  @@schema("sobra_corte")
}

model Material {
  id            Int         @id @default(autoincrement())
  code          String
  name          String
  quantity      Float // Saldo Total na fábrica
  unit          String
  type          String
  observation   String?     @default("")
  minStock      Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  factoryUnitId Int
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])

  movements Movement[]
  locations MaterialLocation[] // Relação com os múltiplos locais

  // 🚀 ÍNDICES DE ALTA PERFORMANCE (Evita Full Table Scan na busca)
  @@unique([factoryUnitId, code])
  @@unique([id, factoryUnitId])
  @@index([factoryUnitId, name])
  @@index([factoryUnitId, type])
  @@index([factoryUnitId, quantity(sort: Desc)])
  @@schema("sobra_corte")
}

// 📍 TABELA DE DOMÍNIO (Apenas locais pré-cadastrados, vinculados à Categoria)
model Location {
  id            Int             @id @default(autoincrement())
  name          String
  categoryId    Int?
  factoryUnitId Int
  factoryUnit   FactoryUnit     @relation(fields: [factoryUnitId], references: [id])
  category      CategoryConfig? @relation(fields: [categoryId, factoryUnitId], references: [id, factoryUnitId], onDelete: NoAction)

  materials MaterialLocation[]

  @@unique([factoryUnitId, name])
  @@unique([id, factoryUnitId])
  @@index([factoryUnitId, categoryId])
  @@schema("sobra_corte")
}

// 🔗 TABELA DE JUNÇÃO (Material <-> Localização)
model MaterialLocation {
  materialId    Int
  locationId    Int
  factoryUnitId Int

  // Se no futuro você quiser saber QUANTOS kg tem em CADA prateleira separadamente, 
  // nós já deixamos o campo de quantidade aqui pronto para uso!
  quantity Float? @default(0)

  factoryUnit FactoryUnit @relation(fields: [factoryUnitId], references: [id])
  material    Material    @relation(fields: [materialId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)
  location    Location    @relation(fields: [locationId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)

  @@id([materialId, locationId]) // Impede que o mesmo material seja duplicado no mesmo local
  @@index([factoryUnitId, locationId])
  @@schema("sobra_corte")
}

model Movement {
  id       Int    @id @default(autoincrement())
  type     String
  quantity Float

  origem String? // Opcional para não quebrar os registros antigos

  reason    String?
  createdAt DateTime @default(now())

  materialId    Int
  factoryUnitId Int
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])
  material      Material    @relation(fields: [materialId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)

  // DADOS DA API DA DASS (Gravamos apenas o histórico, sem Foreign Key)
  operatorId   String? // Matrícula vinda da DASS
  operatorName String? // Nome vindo da DASS

  @@index([factoryUnitId, materialId])
  @@index([factoryUnitId, createdAt])
  @@index([factoryUnitId, origem, createdAt])
  @@schema("sobra_corte")
}

// TABELA DE USUÁRIOS (Persistência para Níveis de Acesso)
model User {
  id      Int     @id @default(autoincrement())
  usuario String
  nome    String
  email   String
  setor   String?
  funcao  String? // Cargo que vem do RH
  role    String  @default("leitor") // Nível de acesso manual do nosso sistema

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  factoryUnitId Int
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])

  // Apenas a chave estrangeira para ligar com a DASS
  matriculaDass BigInt?
  dassInfo      UsuariosDass? @relation(fields: [matriculaDass], references: [matricula])

  @@unique([factoryUnitId, usuario])
  @@unique([factoryUnitId, email])
  @@unique([factoryUnitId, matriculaDass])
  @@schema("sobra_corte")
}

// Essa é a tabela de referencia de usuarios da api principal de autenticacao. Nao deve ser auterada de forma alguma, só deve ser utilizada como referencia ao usuario da api.
model UsuariosDass {
  id           BigInt    @default(autoincrement())
  createdAt    DateTime? @default(now()) @map("createdat") @db.Timestamptz
  updatedAt    DateTime? @default(now()) @map("updatedat") @db.Timestamptz
  codigoBarras BigInt    @map("codigo_barras")
  matricula    BigInt    @unique(map: "matricula_unique")
  nome         String?   @db.VarChar
  usuario      String?   @db.VarChar
  senha        String?   @db.VarChar
  funcao       String?   @db.VarChar
  setor        String?   @db.VarChar
  testeCalce   Int?      @default(0) @map("teste_calce")
  penseAja     Int?      @default(0) @map("pense_aja")
  season       Int?      @default(0)
  ambulatorio  Int?      @default(0)
  limpeza      Int?      @default(0)
  telas        Int?
  unidade      String?   @db.VarChar
  nivel        String?   @db.VarChar
  peConfirmado Int?      @map("pe_confirmado")
  rfid         BigInt?

  // Relação com a tabela User do app
  userApps User[]

  @@id([id, codigoBarras, matricula], map: "usuarios_pk")
  @@map("usuarios")
  @@schema("autenticacao")
}

// 📐 TABELA DE CONFIGURAÇÃO: Unidades de Medida Permitidas
model UnitConfig {
  id            Int              @id @default(autoincrement())
  name          String // Ex: "Metro Quadrado", "Quilograma", "Unidade"
  symbol        String
  active        Boolean          @default(true)
  factoryUnitId Int
  factoryUnit   FactoryUnit      @relation(fields: [factoryUnitId], references: [id])
  categories    CategoryConfig[]

  @@unique([factoryUnitId, symbol])
  @@unique([id, factoryUnitId])
  @@schema("sobra_corte")
}

// 🏷️ TABELA DE CONFIGURAÇÃO: Valores permitidos para Material.type
// Substitui o array hardcoded no frontend (TECIDO, COURO, LINHA, etc.)
model CategoryConfig {
  id            Int         @id @default(autoincrement())
  name          String
  unitLock      String      @default("livre") // "m2" | "m" | "livre" (Legado)
  unitLocked    Boolean     @default(false)
  defaultUnitId Int?
  factoryUnitId Int
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])
  defaultUnit   UnitConfig? @relation(fields: [defaultUnitId, factoryUnitId], references: [id, factoryUnitId], onDelete: NoAction)
  locations     Location[]

  @@unique([factoryUnitId, name])
  @@unique([id, factoryUnitId])
  @@index([factoryUnitId, defaultUnitId])
  @@schema("sobra_corte")
}

// 🔖 TABELA DE CONFIGURAÇÃO: Valores permitidos para Movement.origem
// Substitui o array hardcoded no frontend (Consumo, Dublagem / Tirada, etc.)
model OriginConfig {
  id            Int         @id @default(autoincrement())
  name          String
  factoryUnitId Int
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])

  @@unique([factoryUnitId, name])
  @@schema("sobra_corte")
}
