generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
  schemas  = ["sobra_corte"]
}

enum SectorType {
  CORTE
  APOIO
  PRE_FABRICADO
  DISTRIBUICAO
  EXPEDICAO
  MONTAGEM
  CONFIGURACOES

  @@schema("sobra_corte")
}

enum ComponentType {
  MATERIA_PRIMA
  PECA_CORTADA
  SOLADO
  CABEDAL
  PE_PRONTO

  @@schema("sobra_corte")
}

enum FootSide {
  E // Pé Esquerdo
  D // Pé Direito
  PAR // Par Completo

  @@schema("sobra_corte")
}

enum MovementType {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  REFUGO
  CASAMENTO_PAR
  SAIDA_REQUISICAO
  EXCLUSAO_CONFIGURACAO
  EDICAO_CONFIGURACAO
  CRIACAO_CONFIGURACAO

  @@schema("sobra_corte")
}

enum SubsectorCategoryMode {
  ALL
  SELECTED

  @@schema("sobra_corte")
}

model FactoryUnit {
  id                 Int     @id @default(autoincrement())
  code               String  @unique
  name               String
  active             Boolean @default(true)
  enableRequisitions Boolean @default(true)

  locations          Location[]
  users              User[]
  nativeIdentities   AuthIdentity[] @relation("IdentityNativeUnit")
  userRoleBindings   UserRoleBinding[]
  categories         CategoryConfig[]
  componentSubtypes  ComponentSubtypeConfig[]
  userSubsectorAccesses UserSubsectorAccess[]
  subsectorCategoryLinks SubsectorCategory[]
  origins            OriginConfig[]
  locationCategories LocationCategory[]
  stockItems         StockItem[]
  stockItemLocations StockItemLocation[]
  stockMovements     StockMovement[]
  requisitions       MaterialRequisition[]
  requisitionStockCompatibilities RequisitionStockCompatibility[]
  materialDeletionAudits MaterialDeletionAudit[]
  roleChangeAudits   RoleChangeAudit[]
  subsectors         SubsectorConfig[]

  @@schema("sobra_corte")
}

// 📍 TABELA DE DOMÍNIO (Apenas locais pré-cadastrados, vinculados a Categorias)
model Location {
  id            Int             @id @default(autoincrement())
  name          String
  sector        SectorType?     // Setor ao qual a localização/prateleira pertence
  subsectorId   Int?
  categoryMode  SubsectorCategoryMode @default(SELECTED) // Preserva a restrição explícita das localizações antigas.
  categoryId    Int?
  factoryUnitId Int
  factoryUnit   FactoryUnit     @relation(fields: [factoryUnitId], references: [id])
  subsector     SubsectorConfig? @relation(fields: [subsectorId, factoryUnitId], references: [id, factoryUnitId], onDelete: Restrict)
  category      CategoryConfig? @relation(fields: [categoryId, factoryUnitId], references: [id, factoryUnitId], onDelete: NoAction)

  stockLocations StockItemLocation[]
  categoryLinks  LocationCategory[]

  @@unique([factoryUnitId, name])
  @@unique([id, factoryUnitId])
  @@index([factoryUnitId, categoryId])
  @@index([factoryUnitId, sector])
  @@index([factoryUnitId, subsectorId])
  @@schema("sobra_corte")
}

// 🔗 TABELA DE JUNÇÃO (Location <-> CategoryConfig - Vínculo Multi-Categoria)
model LocationCategory {
  locationId    Int
  categoryId    Int
  factoryUnitId Int

  factoryUnit FactoryUnit    @relation(fields: [factoryUnitId], references: [id])
  location    Location       @relation(fields: [locationId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)
  category    CategoryConfig @relation(fields: [categoryId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)

  @@id([locationId, categoryId])
  @@index([factoryUnitId, locationId])
  @@index([factoryUnitId, categoryId])
  @@schema("sobra_corte")
}

// TABELA DE USUÁRIOS (Persistência para Níveis de Acesso)
model User {
  id             Int         @id @default(autoincrement())
  usuario        String
  nome           String
  email          String
  setor          String?
  assignedSector SectorType? // Setor vinculado para controle RBAC setorial (CORTE, APOIO, PRE_FABRICADO, EXPEDICAO, MONTAGEM)
  funcao         String?     // Cargo que vem do RH
  role           String      @default("leitor") // Nível de acesso manual do nosso sistema

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  factoryUnitId Int
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])

  // Matrícula DASS (Armazenamento de referência sem FK física externa)
  matriculaDass BigInt?

  // Preserve the stable identity introduced in production. This upgrade does
  // not change authentication policy or discard external identity references.
  authOrigin String?
  authUserId String?

  @@unique([factoryUnitId, authOrigin, authUserId])
  @@unique([id, factoryUnitId])
  @@schema("sobra_corte")
}

// Identidade autenticada é vinculada somente à sua unidade de origem. RBAC
// local vive em UserRoleBinding para que uma visita global não crie usuário local.
model AuthIdentity {
  id             Int         @id @default(autoincrement())
  nativeUnitId   Int
  authOrigin     String
  authUserId     String
  usuario        String
  nome           String
  email          String
  setor          String?
  funcao         String?
  matriculaDass  BigInt?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  nativeUnit     FactoryUnit @relation("IdentityNativeUnit", fields: [nativeUnitId], references: [id])
  bindings       UserRoleBinding[]

  @@unique([nativeUnitId, authOrigin, authUserId])
  @@index([nativeUnitId, matriculaDass])
  @@schema("sobra_corte")
}

model UserRoleBinding {
  id             Int          @id @default(autoincrement())
  identityId     Int
  factoryUnitId  Int
  role           String       @default("leitor")
  assignedSector SectorType?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  identity       AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  factoryUnit    FactoryUnit  @relation(fields: [factoryUnitId], references: [id])
  audits         RoleChangeAudit[]
  subsectorAccesses UserSubsectorAccess[]

  @@unique([identityId, factoryUnitId])
  @@unique([id, factoryUnitId])
  @@index([factoryUnitId, identityId])
  @@schema("sobra_corte")
}

// Evidência interna de conflitos da migração; não expor como modelo da API.
model IdentityMigrationConflict {
  id            Int      @id @default(autoincrement())
  conflictKey   String   @unique
  nativeUnitId  Int
  authOrigin    String
  authUserId    String
  reason        String
  legacyUserIds Json
  createdAt     DateTime @default(now())

  @@ignore
  @@schema("sobra_corte")
}

// 🛡️ TABELA DE AUDITORIA DE ALTERAÇÃO DE PERMISSÕES RBAC (LGPD / SEGURANÇA DASS)
model RoleChangeAudit {
  id             Int          @id @default(autoincrement())
  userId         Int
  bindingId      Int?
  usuario        String
  nome           String
  previousRole   String
  newRole        String
  previousSector SectorType?
  newSector      SectorType?
  changedById    String?      // Matrícula DASS do operador que executou a alteração
  changedByName  String       // Nome do operador
  factoryUnitId  Int
  factoryUnit    FactoryUnit  @relation(fields: [factoryUnitId], references: [id])
  binding        UserRoleBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)
  changedAt      DateTime     @default(now())

  @@index([factoryUnitId, userId])
  @@index([factoryUnitId, changedAt(sort: Desc)])
  @@schema("sobra_corte")
}

// 🏷️ TABELA DE CONFIGURAÇÃO: Valores permitidos para Material.type
// Substitui o array hardcoded no frontend (TECIDO, COURO, LINHA, etc.)
enum CategoryEntryMode {
  QUANTITY
  SIDE_PAIR

  @@schema("sobra_corte")
}

model CategoryConfig {
  id            Int         @id @default(autoincrement())
  name          String
  sector        SectorType? // Setor vinculado à categoria (CORTE, APOIO, etc.)
  sectors       SectorType[] @default([]) // Setores em que a categoria pode ser usada; vazio com sector nulo significa geral
  subtypeId     Int?
  subtype       ComponentSubtypeConfig? @relation(fields: [subtypeId, factoryUnitId], references: [id, factoryUnitId], onDelete: NoAction)
  componentType ComponentType? // Metadado legado, preservado para histórico
  unitLocked    Boolean     @default(false)
  defaultUnitCode String?
  entryMode     CategoryEntryMode @default(QUANTITY)
  factoryUnitId Int
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])
  locations     Location[]
  locationLinks LocationCategory[]
  stockItems    StockItem[]
  subsectorCategoryLinks SubsectorCategory[]

  @@unique([factoryUnitId, name])
  @@unique([id, factoryUnitId])
  @@index([factoryUnitId, sector])
  @@index([factoryUnitId, subtypeId])
  @@schema("sobra_corte")
}

// Opções legadas arquivadas após a adoção de regras por categoria. componentType preserva
// a classificação histórica anterior às regras por categoria.
model ComponentSubtypeConfig {
  id            Int            @id @default(autoincrement())
  name          String
  sectors       SectorType[]   @default([])
  componentType ComponentType?
  factoryUnitId Int
  factoryUnit   FactoryUnit    @relation(fields: [factoryUnitId], references: [id])
  categories    CategoryConfig[]

  @@unique([factoryUnitId, name])
  @@unique([id, factoryUnitId])
  @@schema("sobra_corte")
}

// Subsetores operacionais pertencentes a um único setor e unidade fabril.
// Registros usados são arquivados com active=false, não excluídos.
model SubsectorConfig {
  id             Int                   @id @default(autoincrement())
  factoryUnitId  Int
  sector         SectorType
  name           String
  normalizedName String
  active         Boolean               @default(true)
  categoryMode   SubsectorCategoryMode @default(ALL)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt
  factoryUnit    FactoryUnit           @relation(fields: [factoryUnitId], references: [id], onDelete: Restrict)
  userAccesses   UserSubsectorAccess[]
  categoryLinks  SubsectorCategory[]
  stockItems     StockItem[]
  locations      Location[]
  stockMovements StockMovement[]

  @@unique([factoryUnitId, sector, normalizedName])
  @@unique([id, factoryUnitId])
  @@index([factoryUnitId, sector, active])
  @@schema("sobra_corte")
}

// Uma atribuição por vínculo de papel/setor e subsetor.
model UserSubsectorAccess {
  bindingId     Int
  subsectorId   Int
  factoryUnitId Int
  binding       UserRoleBinding @relation(fields: [bindingId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)
  subsector     SubsectorConfig @relation(fields: [subsectorId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)
  factoryUnit   FactoryUnit     @relation(fields: [factoryUnitId], references: [id], onDelete: Restrict)

  @@id([bindingId, subsectorId, factoryUnitId])
  @@index([factoryUnitId, bindingId])
  @@index([factoryUnitId, subsectorId])
  @@schema("sobra_corte")
}

// Whitelist opcional de categorias quando o subsetor estiver em SELECTED.
model SubsectorCategory {
  subsectorId      Int
  categoryConfigId Int
  factoryUnitId    Int
  subsector        SubsectorConfig @relation(fields: [subsectorId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)
  categoryConfig   CategoryConfig  @relation(fields: [categoryConfigId, factoryUnitId], references: [id, factoryUnitId], onDelete: Restrict)
  factoryUnit      FactoryUnit     @relation(fields: [factoryUnitId], references: [id], onDelete: Restrict)

  @@id([subsectorId, categoryConfigId, factoryUnitId])
  @@index([factoryUnitId, categoryConfigId])
  @@schema("sobra_corte")
}

// 🔖 TABELA DE CONFIGURAÇÃO: Valores permitidos para Movement.origem
// Substitui o array hardcoded no frontend (Consumo, Dublagem / Tirada, etc.)
model OriginConfig {
  id            Int         @id @default(autoincrement())
  name          String
  sector        SectorType? // Setor vinculado à origem/motivo (CORTE, APOIO, etc.)
  factoryUnitId Int
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])

  @@unique([factoryUnitId, name])
  @@index([factoryUnitId, sector])
  @@schema("sobra_corte")
}

// =======================================================
// 📦 TABELA UNIFICADA DE ESTOQUE MULTI-SETOR
// =======================================================
model StockItem {
  id            Int            @id @default(autoincrement())
  factoryUnitId Int
  sector        SectorType     @default(CORTE)
  subsectorId   Int?
  categoryId    Int?
  componentType ComponentType?
  quantity      Decimal        @default(0) @db.Decimal(18, 3)
  observation   String?        @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // 🔹 CORTE (Matéria-Prima Bruta)
  code          String?     // Código da matéria-prima
  name          String?     // Descrição do material (ex: Couro Bovino Preto)
  unit          String?     // m², kg, m, UN
  type          String?     // Categoria (Couro, Tecido, Sintético)
  minStock      Decimal?    @default(0) @db.Decimal(18, 3)

  // 🔹 APOIO (Peças Cortadas / Moldes)
  pieceCode     String?     // Código do Molde / Peça avulsa
  description   String?     // Descrição da peça (ex: Gáspea Externa)
  materialColor String?     // Material e Cor da peça (ex: Napa Branca)

  // 🔹 PRÉ-FABRICADO (Solas por Produto)
  productName   String?     // Nome / Linha do Produto (ex: Pegasus 40)

  // 🔹 EXPEDIÇÃO (Cabedais por SKU) & MONTAGEM (Pés Prontos por SKU)
  sku           String?     // SKU / Modelo do Calçado (ex: NKE-PEG-38-BLK)

  // 🔹 CAMPOS COMPARTILHADOS (Apoio, Pré-Fabricado, Expedição, Montagem)
  color         String?     // Cor do componente
  sizeGrade     String?     // Grade / Numeração (ex: "37/38", "40", "41")
  footSide      FootSide?   // Lado: E (Esquerdo) | D (Direito) - Exclusivo Montagem

  // Relações Multi-Tenant Compostas
  factoryUnit   FactoryUnit         @relation(fields: [factoryUnitId], references: [id])
  subsector     SubsectorConfig?    @relation(fields: [subsectorId, factoryUnitId], references: [id, factoryUnitId], onDelete: Restrict)
  category      CategoryConfig?     @relation(fields: [categoryId, factoryUnitId], references: [id, factoryUnitId], onDelete: NoAction)
  locations     StockItemLocation[]
  movements     StockMovement[]
  requisitionCompatibilityLinks RequisitionStockCompatibility[]

  // 🚀 ÍNDICES COMPOSTOS ESTRATÉGICOS
  @@unique([id, factoryUnitId])
  @@unique([factoryUnitId, code, footSide])
  @@index([factoryUnitId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([factoryUnitId, name])
  @@index([factoryUnitId, type])
  @@index([factoryUnitId, categoryId])
  @@index([factoryUnitId, subsectorId, createdAt(sort: Desc)])
  @@index([factoryUnitId, quantity(sort: Desc)])
  @@index([factoryUnitId, sector, createdAt(sort: Desc)])
  @@index([factoryUnitId, sector, productName, sizeGrade])
  @@index([factoryUnitId, sector, sku, sizeGrade])
  @@index([factoryUnitId, sector, sku, sizeGrade, color, footSide])
  @@index([factoryUnitId, sector, pieceCode])
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@schema("sobra_corte")
}

// 📍 LOCALIZAÇÃO FÍSICA NO ESTOQUE (PRATELEIRAS/BOXES)
model StockItemLocation {
  stockItemId   Int
  locationId    Int
  factoryUnitId Int
  quantity      Decimal     @default(0) @db.Decimal(18, 3)

  stockItem     StockItem   @relation(fields: [stockItemId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)
  location      Location    @relation(fields: [locationId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])

  @@id([stockItemId, locationId])
  @@unique([stockItemId, locationId, factoryUnitId])
  @@index([factoryUnitId, locationId])
  @@schema("sobra_corte")
}

// 🛡️ HISTÓRICO COMPLETO DE AUDITORIA & RASTREABILIDADE
model StockMovement {
  id                    Int          @id @default(autoincrement())
  factoryUnitId         Int
  stockItemId           Int?
  subsectorId           Int?
  sector                SectorType
  type                  MovementType
  quantity              Decimal      @db.Decimal(18, 3)
  
  // Localizações de origem/destino
  sourceLocationId      Int?
  destinationLocationId Int?
  sourceLocationName    String?
  destinationLocationName String?

  // Snapshots Imutáveis de StockItem
  itemCode              String?
  itemName              String?
  itemCategory          String?
  itemUnit              String?
  itemModelName         String?
  itemSizeGrade         String?
  itemFootSide          String?
  itemColor             String?
  // Identificadores históricos: preservados mesmo após exclusão do item.
  sourceStockItemId     Int?
  destinationStockItemId Int?
  sourceSector          SectorType?
  destinationSector     SectorType?
  
  origem                String?      // Motivo cadastrado (Consumo, Refugo, Casamento, Transferência)
  reason                String?      // Observação detalhada da ação
  createdAt             DateTime     @default(now())

  // Identificação do Operador
  operatorId            String?      // Matrícula DASS
  operatorName          String?      // Nome do usuário

  factoryUnit           FactoryUnit  @relation(fields: [factoryUnitId], references: [id])
  subsector             SubsectorConfig? @relation(fields: [subsectorId, factoryUnitId], references: [id, factoryUnitId], onDelete: Restrict)
  stockItem             StockItem?   @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@index([factoryUnitId, stockItemId])
  @@index([factoryUnitId, subsectorId, createdAt(sort: Desc)])
  @@index([factoryUnitId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([factoryUnitId, sector, createdAt(sort: Desc)])
  @@index([factoryUnitId, operatorId, createdAt])
  @@index([factoryUnitId, origem, createdAt])
  @@schema("sobra_corte")
}

enum RequisitionStatus {
  PENDENTE
  ATENDIDA_TOTAL
  ATENDIDA_PARCIAL
  CANCELADA

  @@schema("sobra_corte")
}

// 📋 REQUISIÇÃO DIGITAL DE REPOSIÇÃO (MÓDULO DIGITAL DE REQUISIÇÕES)
model MaterialRequisition {
  categoryId        Int?              // Categoria selecionada; nulo somente em requisições históricas
  id                String            @id @default(uuid())
  code              String            // Ex: REQ-2026-0001
  requestSector     SectorType        // Setor solicitante: CORTE, APOIO, PRE_FABRICADO, EXPEDICAO, MONTAGEM
  requestUnit       String?           // Unidade na qual a quantidade solicitada é expressa
  sourceStockItemIds Int[]            @default([]) // Item(ns) fornecedor(es) selecionado(s), sem misturar setores
  sourceCompatibilityIds Int[]        @default([]) // Vínculos BOM aplicados quando a origem é de outro setor
  sourceSector      SectorType?       // Setor que fornecerá o saldo
  sourceQuantityPerRequestUnit Decimal @default(1) @db.Decimal(18, 6)
  sourceMatchReason String?           // Motivo de compatibilidade exibido ao solicitante
  sku               String?           // COD. PRODUTO / SKU (caixa alta)
  modelName         String?           // NOME DO MODELO / LINHA (caixa alta)
  type              String?           // Tipo solicitado, para preservar a identidade selecionada
  description       String            // Peça / Material solicitado
  color             String?           // Cor / Combinação do item
  sizeGrade         String?           // Grade / Tamanho (ex: 39/40)
  footSide          FootSide?         // E / D ou null
  quantityRequested Decimal           @db.Decimal(18, 3) // Quantidade solicitada
  quantityFulfilled Decimal           @default(0) @db.Decimal(18, 3) // Quantidade atendida
  reason            String            // Motivo da avaria / defeito
  status            RequisitionStatus @default(PENDENTE)

  requesterId       String?           // Matrícula DASS do solicitante
  requesterName     String?           // Nome do solicitante
  factoryUnitId     Int
  factoryUnit       FactoryUnit       @relation(fields: [factoryUnitId], references: [id])

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([factoryUnitId, code])
  @@index([factoryUnitId, status, createdAt(sort: Desc)])
  @@index([factoryUnitId, requestSector, status])
  @@index([factoryUnitId, sourceSector, status], map: "MaterialRequisition_supplier_status_idx")
  @@index([factoryUnitId, sku])
  @@index([factoryUnitId, sku, color])
  @@unique([id, factoryUnitId])
  @@schema("sobra_corte")
}

// Vínculo explícito entre um produto solicitado e uma sobra de outro setor.
// Campos de variante vazios são curingas definidos pelo administrador.
model RequisitionStockCompatibility {
  id                       Int         @id @default(autoincrement())
  factoryUnitId            Int
  requestSector            SectorType
  requestSku               String?
  requestDescription       String?
  requestModelName         String?
  requestType              String?
  requestColor             String?
  requestSizeGrade         String?
  requestFootSide          FootSide?
  matchKey                 String
  requestUnit              String
  sourceStockItemId        Int
  sourceSector             SectorType
  sourceQuantityPerRequestUnit Decimal @default(1) @db.Decimal(18, 6)
  reason                   String
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id], onDelete: Cascade)
  sourceStockItem StockItem @relation(fields: [sourceStockItemId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)

  @@unique([factoryUnitId, requestSector, matchKey, sourceStockItemId])
  @@index([factoryUnitId, requestSector, requestSku], map: "RequisitionStockCompatibility_target_idx")
  @@index([factoryUnitId, requestSector, requestDescription], map: "RequisitionStockCompatibility_target_description_idx")
  @@index([factoryUnitId, sourceSector, sourceStockItemId])
  @@schema("sobra_corte")
}

// 🗑️ AUDITORIA DE MATERIAIS EXCLUÍDOS (SNAPSHOT COMPLETO & SEGURANÇA OPERACIONAL)
model MaterialDeletionAudit {
  id            Int         @id @default(autoincrement())
  factoryUnitId Int
  materialId    Int
  code          String
  name          String
  categoryName  String?
  unitSymbol    String
  quantity      Decimal     @db.Decimal(18, 3)
  locations     Json?
  deletedById   String?
  deletedByName String
  deletedAt     DateTime    @default(now())

  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])

  @@index([factoryUnitId, deletedAt])
  @@index([factoryUnitId, code])
  @@schema("sobra_corte")
}
