generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
  schemas  = ["sobra_corte"]
}

model FactoryUnit {
  id     Int     @id @default(autoincrement())
  code   String  @unique
  name   String
  active Boolean @default(true)

  materials         Material[]
  locations         Location[]
  materialLocations MaterialLocation[]
  movements         Movement[]
  deletionAudits    MaterialDeletionAudit[]
  users             User[]
  units             UnitConfig[]
  categories        CategoryConfig[]
  origins           OriginConfig[]

  @@schema("sobra_corte")
}

model Material {
  id            Int            @id @default(autoincrement())
  code          String
  name          String
  quantity      Decimal        @db.Decimal(18, 3) // Saldo Total na fábrica
  categoryId    Int
  unitId        Int
  observation   String?        @default("")
  minStock      Decimal        @default(0) @db.Decimal(18, 3)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  factoryUnitId Int
  factoryUnit   FactoryUnit    @relation(fields: [factoryUnitId], references: [id])
  category      CategoryConfig @relation(fields: [categoryId, factoryUnitId], references: [id, factoryUnitId])
  unit          UnitConfig     @relation(fields: [unitId, factoryUnitId], references: [id, factoryUnitId])

  movements Movement[]
  locations MaterialLocation[] // Relação com os múltiplos locais

  // 🚀 ÍNDICES DE ALTA PERFORMANCE (Evita Full Table Scan na busca)
  @@unique([factoryUnitId, code])
  @@unique([id, factoryUnitId])
  @@index([factoryUnitId, name])
  @@index([factoryUnitId, categoryId])
  @@index([factoryUnitId, unitId])
  @@index([factoryUnitId, quantity(sort: Desc)])
  @@schema("sobra_corte")
}

// 📍 TABELA DE DOMÍNIO (Apenas locais pré-cadastrados, vinculados à Categoria)
model Location {
  id            Int                @id @default(autoincrement())
  name          String
  factoryUnitId Int
  factoryUnit   FactoryUnit        @relation(fields: [factoryUnitId], references: [id])
  categories    LocationCategory[]

  materials MaterialLocation[]
  movements Movement[]

  @@unique([factoryUnitId, name])
  @@unique([id, factoryUnitId])
  @@schema("sobra_corte")
}

model LocationCategory {
  locationId    Int
  categoryId    Int
  factoryUnitId Int
  location      Location       @relation(fields: [locationId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)
  category      CategoryConfig @relation(fields: [categoryId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)

  @@id([locationId, categoryId])
  @@index([factoryUnitId, categoryId])
  @@schema("sobra_corte")
}

// 🔗 TABELA DE JUNÇÃO (Material <-> Localização)
model MaterialLocation {
  materialId    Int
  locationId    Int
  factoryUnitId Int

  // Se no futuro você quiser saber QUANTOS kg tem em CADA prateleira separadamente, 
  // nós já deixamos o campo de quantidade aqui pronto para uso!
  quantity Decimal @default(0) @db.Decimal(18, 3)

  factoryUnit FactoryUnit @relation(fields: [factoryUnitId], references: [id])
  material    Material    @relation(fields: [materialId, factoryUnitId], references: [id, factoryUnitId], onDelete: Cascade)
  location    Location    @relation(fields: [locationId, factoryUnitId], references: [id, factoryUnitId], onDelete: Restrict)

  @@id([materialId, locationId]) // Impede que o mesmo material seja duplicado no mesmo local
  @@index([factoryUnitId, locationId])
  @@schema("sobra_corte")
}

model Movement {
  id       Int     @id @default(autoincrement())
  type     String
  quantity Decimal @db.Decimal(18, 3)

  materialCode     String
  materialName     String
  materialCategory String
  materialUnit     String
  locationId       Int?
  locationName     String?
  originId         Int?
  originName       String?

  reason    String?
  createdAt DateTime @default(now())

  materialId    Int?
  factoryUnitId Int
  factoryUnit   FactoryUnit   @relation(fields: [factoryUnitId], references: [id])
  material      Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  location      Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  origin        OriginConfig? @relation(fields: [originId], references: [id], onDelete: SetNull)

  // DADOS DA API DA DASS (Gravamos apenas o histórico, sem Foreign Key)
  operatorId   String? // Matrícula vinda da DASS
  operatorName String? // Nome vindo da DASS

  @@index([factoryUnitId, materialId])
  @@index([factoryUnitId, locationId, createdAt])
  @@index([factoryUnitId, originId, createdAt])
  @@index([factoryUnitId, createdAt])
  @@schema("sobra_corte")
}

model MaterialDeletionAudit {
  id            Int         @id @default(autoincrement())
  materialId    Int?
  code          String
  name          String
  categoryName  String
  unitSymbol    String
  quantity      Decimal     @db.Decimal(18, 3)
  locations     Json
  deletedAt     DateTime    @default(now())
  deletedById   String?
  deletedByName String?
  factoryUnitId Int
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])

  @@index([factoryUnitId, deletedAt])
  @@index([factoryUnitId, materialId])
  @@schema("sobra_corte")
}

// TABELA DE USUÁRIOS (Persistência para Níveis de Acesso)
model User {
  id      Int     @id @default(autoincrement())
  usuario String
  nome    String
  email   String
  setor   String?
  funcao  String? // Cargo que vem do RH
  role    String  @default("leitor") // Nível de acesso manual do nosso sistema

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  factoryUnitId Int
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])

  // Identificador externo vindo da DASS; sem FK entre domínios.
  matriculaDass BigInt?

  @@unique([factoryUnitId, usuario])
  @@unique([factoryUnitId, email])
  @@unique([factoryUnitId, matriculaDass])
  @@schema("sobra_corte")
}

// 📐 TABELA DE CONFIGURAÇÃO: Unidades de Medida Permitidas
model UnitConfig {
  id            Int              @id @default(autoincrement())
  name          String // Ex: "Metro Quadrado", "Quilograma", "Unidade"
  symbol        String
  active        Boolean          @default(true)
  factoryUnitId Int
  factoryUnit   FactoryUnit      @relation(fields: [factoryUnitId], references: [id])
  categories    CategoryConfig[]
  materials     Material[]

  @@unique([factoryUnitId, symbol])
  @@unique([id, factoryUnitId])
  @@schema("sobra_corte")
}

// 🏷️ TABELA DE CONFIGURAÇÃO: Valores permitidos para Material.type
// Substitui o array hardcoded no frontend (TECIDO, COURO, LINHA, etc.)
model CategoryConfig {
  id            Int                @id @default(autoincrement())
  name          String
  unitLocked    Boolean            @default(false)
  defaultUnitId Int?
  factoryUnitId Int
  factoryUnit   FactoryUnit        @relation(fields: [factoryUnitId], references: [id])
  defaultUnit   UnitConfig?        @relation(fields: [defaultUnitId, factoryUnitId], references: [id, factoryUnitId], onDelete: NoAction)
  locations     LocationCategory[]
  materials     Material[]

  @@unique([factoryUnitId, name])
  @@unique([id, factoryUnitId])
  @@index([factoryUnitId, defaultUnitId])
  @@schema("sobra_corte")
}

// 🔖 TABELA DE CONFIGURAÇÃO: Valores permitidos para Movement.origem
// Substitui o array hardcoded no frontend (Consumo, Dublagem / Tirada, etc.)
model OriginConfig {
  id            Int         @id @default(autoincrement())
  name          String
  factoryUnitId Int
  factoryUnit   FactoryUnit @relation(fields: [factoryUnitId], references: [id])
  movements     Movement[]

  @@unique([factoryUnitId, name])
  @@schema("sobra_corte")
}
